{
  "name": "tfast-ads-manager-server",
  "version": "0.1.0",
  "private": true,
  "description": "TFast Ads Manager backend — multi-tenant AI advertising operating system for TFast Digital Agency.",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "verify:pipeline": "tsx scripts/verify-pipeline.ts",
    "verify:business": "tsx scripts/verify-business.ts",
    "verify:ai": "tsx scripts/verify-ai.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.6",
    "@electric-sql/pglite-pgvector": "^0.0.7",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "openai": "^4.56.0",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "license": "MIT"
}
