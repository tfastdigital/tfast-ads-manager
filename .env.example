# TFast Ads Manager — environment template
# Copy to .env and fill in real values. NEVER commit .env.

# ── AI Providers ──────────────────────────────────────────
# Primary reasoning/orchestration provider
OPENAI_API_KEY=
# Secondary high-volume analysis provider (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Market Intelligence ───────────────────────────────────
# API Direct — external market/social research layer
APIDIRECT_API_KEY=
# Optional replacement key. When set, it takes precedence over APIDIRECT_API_KEY.
APIDIRECT_API_KEY_LIVE=
APIDIRECT_BASE_URL=https://apidirect.io

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tfast

# ── Server ────────────────────────────────────────────────
PORT=8787
LOG_LEVEL=info
NODE_ENV=development

# ── Scheduler (in-process; production should use a job runner) ──
# 0 = disabled
MORNING_BRIEF_INTERVAL_HOURS=0
TIKTOK_SYNC_INTERVAL_HOURS=0
META_SYNC_INTERVAL_HOURS=0
GOOGLE_SYNC_INTERVAL_HOURS=0

# ── Auth ──────────────────────────────────────────────────
# HMAC secret for session JWTs. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# ── MCP / Platform Gateways ───────────────────────────────
# TikTok for Business MCP Server (official). No API key needed — the server
# authorizes via OAuth (DCR + PKCE, see the custom-agent docs); TIKTOK_MCP_TOKEN
# is only a legacy fallback and can stay empty.
# tt-ads-mcp-layer = progressive disclosure (~40 core tools, token-conscious).
# tt-ads-mcp-flat   = full disclosure (~400 tools, big context windows).
TIKTOK_MCP_URL=https://business-api.tiktok.com/open_mcp/tt-ads-mcp-layer
TIKTOK_MCP_TOKEN=
# Redirect URI registered during DCR; must match the callback route 1:1.
TIKTOK_MCP_REDIRECT_URI=http://127.0.0.1:8787/api/v1/oauth/tiktok-mcp/callback
# ── TikTok OAuth 2.0 — recommended connection method ──
# From the TikTok for Business developer portal (Marketing API app).
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# Must match the redirect URI registered in the TikTok app settings.
TIKTOK_REDIRECT_URI=http://127.0.0.1:8787/api/v1/oauth/tiktok/callback
# Dev only: mocks the TikTok OAuth side so the flow is testable locally.
# The "auth URL" points at the local callback and any code is accepted.
TIKTOK_MOCK_OAUTH=false
